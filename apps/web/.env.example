# 32 random bytes, base64: openssl rand -base64 32
# Encrypts stored BookingBoard passwords and tokens. Losing it means everyone logs in again.
APP_ENCRYPTION_KEY=
# Where app.db lives (default ./data)
DATA_DIR=./data
# BookingBoard (defaults: CrossFit Roskilde)
API_BASE_URL=https://crossfitroskilde.mobile.api.bookingboard.io
CHAIN_ID=291
# Worker: set to 1 to compute + log without booking
DRY_RUN=
# Web Push (both web and worker). Generate once:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Changing them invalidates every device's subscription.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
