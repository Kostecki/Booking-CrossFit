# Booking (BookingBoard API)
API_EMAIL=you@example.com
API_PASSWORD=your-password-here
CHAIN_ID=291
# participantId -> display name, for "also attending".
# Discover ids with: node --env-file=.env scripts/find-participants.ts <classId>
TRACKED_PEOPLE={"123456":"Name1","234567":"Name2"}
# Set to 1 to compute + log intended bookings without actually booking.
DRY_RUN=

# Pushover
PUSHOVER_TOKEN=your-pushover-app-token
PUSHOVER_USER=your-pushover-user-key
